          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.zxbo{margin:8px 0 14px;font-family:'Inter',sans-serif}\n.zxbo-h{font:600 11px/1 'Inter',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#7D6130;margin:0 0 12px;display:flex;align-items:center;gap:10px}\n.zxbo-h::after{content:\"\";flex:1;height:1px;background:rgba(43,52,46,.12)}\n.zxbo-opt{position:relative;display:flex;align-items:center;gap:14px;width:100%;text-align:left;cursor:pointer;background:#FBF9F4;border:1px solid rgba(43,52,46,.18);border-radius:12px;padding:17px 18px;margin:0 0 12px;transition:border-color .25s,box-shadow .25s,background .25s}\n.zxbo-opt:hover{border-color:rgba(31,39,35,.45)}\n.zxbo-opt.is-active{border-color:#1F2723;box-shadow:0 0 0 1px #1F2723;background:#FFFFFF}\n.zxbo-radio{flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid rgba(43,52,46,.35);display:grid;place-items:center;transition:border-color .25s}\n.zxbo-opt.is-active .zxbo-radio{border-color:#1F2723}\n.zxbo-opt.is-active .zxbo-radio::after{content:\"\";width:10px;height:10px;border-radius:50%;background:#C0683F}\n.zxbo-main{flex:1}\n.zxbo-main b{display:block;font:600 15px/1.3 'Inter',sans-serif;color:#1F2723}\n.zxbo-sub{display:block;font-size:12.5px;color:#6B746E;margin-top:3px}\n.zxbo-price{flex:none;text-align:right;font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:1.25rem;color:#1F2723;white-space:nowrap}\n.zxbo-price s{display:block;font-family:'Inter',sans-serif;font-size:11.5px;color:#9aa39d}\n.zxbo-price .per{display:block;font-family:'Inter',sans-serif;font-size:10.5px;color:#9E4F2E;letter-spacing:.04em}\n.zxbo-tag{position:absolute;top:-11px;right:16px;background:#1F2723;color:#E3CBA0;font:700 10px/1 'Inter',sans-serif;letter-spacing:.12em;text-transform:uppercase;padding:5px 11px;border-radius:999px}\n.zxbo-colors{background:#FFFFFF;border:1px solid rgba(43,52,46,.18);border-radius:12px;padding:15px 16px;margin:0 0 12px}\n.zxbo-ch{margin:0 0 10px;font:600 11px/1 'Inter',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#7D6130}\n.zxbo-cl{display:flex;align-items:center;gap:12px;margin:0 0 8px}\n.zxbo-cl:last-child{margin-bottom:0}\n.zxbo-cl>span{flex:none;width:44px;font:600 12px/1 'Inter',sans-serif;color:#6B746E}\n.zxbo-sel{flex:1;appearance:auto;background:#FBF9F4;border:1px solid rgba(43,52,46,.25);border-radius:8px;padding:10px 12px;font:500 13.5px/1.2 'Inter',sans-serif;color:#1F2723}\n.zxbo-note{font-size:12px;color:#6B746E;margin:11px 2px 0;text-align:center}\n</style>\n<div class=\"zxbo\" role=\"radiogroup\" aria-labelledby=\"zxbo-title\">\n  <p class=\"zxbo-h\" id=\"zxbo-title\">Choose your set</p>\n  <button type=\"button\" role=\"radio\" aria-checked=\"true\" class=\"zxbo-opt is-active\" data-zxqty=\"1\">\n    <span class=\"zxbo-radio\" aria-hidden=\"true\"></span>\n    <span class=\"zxbo-main\"><b>1 Set</b><span class=\"zxbo-sub\">One reset, just for you</span></span>\n    <span class=\"zxbo-price\">$49.99</span>\n  </button>\n  <button type=\"button\" role=\"radio\" aria-checked=\"false\" class=\"zxbo-opt\" data-zxqty=\"3\">\n    <span class=\"zxbo-tag\">Buy 2, get 1 free</span>\n    <span class=\"zxbo-radio\" aria-hidden=\"true\"></span>\n    <span class=\"zxbo-main\"><b>3 Sets</b><span class=\"zxbo-sub\">Keep one, gift two &mdash; mix colors freely</span></span>\n    <span class=\"zxbo-price\"><s>$149.97</s>$99.98<span class=\"per\">$33.33 / set</span></span>\n  </button>\n  <div class=\"zxbo-colors\" id=\"zxbo-colors\" hidden>\n    <p class=\"zxbo-ch\">Pick a color for each set</p>\n    <label class=\"zxbo-cl\"><span>Set 1</span><select class=\"zxbo-sel\" data-set=\"1\">{% for v in product.variants %}<option value=\"{{ v.id }}\">{{ v.title }}</option>{% endfor %}</select></label>\n    <label class=\"zxbo-cl\"><span>Set 2</span><select class=\"zxbo-sel\" data-set=\"2\">{% for v in product.variants %}<option value=\"{{ v.id }}\">{{ v.title }}</option>{% endfor %}</select></label>\n    <label class=\"zxbo-cl\"><span>Set 3</span><select class=\"zxbo-sel\" data-set=\"3\">{% for v in product.variants %}<option value=\"{{ v.id }}\">{{ v.title }}</option>{% endfor %}</select></label>\n  </div>\n  <p class=\"zxbo-note\">Your 3rd set is free &mdash; applied automatically at checkout, no code needed.</p>\n</div>\n<script>\n(function(){\n  var SID='{{ section.id }}';\n  var current=1;\n  function form(){return document.getElementById('product-form-'+SID)||document.querySelector('form[action*=\"/cart/add\"][id^=\"product-form-\"]')||document.querySelector('form[action*=\"/cart/add\"]');}\n  function apply(){\n    var f=form();if(!f)return;\n    var i=f.querySelector('input[name=\"quantity\"]');\n    if(!i){i=document.createElement('input');i.type='hidden';i.name='quantity';f.appendChild(i);}\n    if(i.value!=='1'){i.value='1';}\n    var btn=f.querySelector('.product-form__submit');\n    if(btn){var sp=btn.querySelector('span')||btn;\n      var label=current===3?'Add 3 sets \\u2014 $99.98':'Add 1 set \\u2014 $49.99';\n      if(sp.textContent.trim()!==label){sp.textContent=label;}}\n    var bp=document.getElementById('zx-pbar-price');\n    if(bp){var pl=current===3?'$99.98 \\u00b7 3 sets, 1 free':'$49.99';\n      if(bp.textContent!==pl){bp.textContent=pl;}}\n    var cp=document.getElementById('zxbo-colors');\n    if(cp){var want=current===3;\n      if(cp.hidden===want){cp.hidden=!want;\n        if(want){var idi=f.querySelector('input[name=\"id\"]');var cur=idi?idi.value:null;\n          if(cur){cp.querySelectorAll('.zxbo-sel').forEach(function(s){s.value=cur;});}}}}\n  }\n  window.zxApplyQty=apply;\n  var opts=document.querySelectorAll('.zxbo .zxbo-opt');\n  opts.forEach(function(o){o.addEventListener('click',function(){\n    opts.forEach(function(x){x.classList.remove('is-active');x.setAttribute('aria-checked','false');});\n    o.classList.add('is-active');o.setAttribute('aria-checked','true');\n    current=parseInt(o.getAttribute('data-zxqty'),10)||1;apply();});});\n  /* 3-set purchases: add the three chosen variants via cart API */\n  function bundleAdd(){\n    var sels=document.querySelectorAll('#zxbo-colors .zxbo-sel');\n    var counts={};\n    sels.forEach(function(s){counts[s.value]=(counts[s.value]||0)+1;});\n    var items=Object.keys(counts).map(function(id){return{id:parseInt(id,10),quantity:counts[id]};});\n    var f=form();var btn=f&&f.querySelector('.product-form__submit');\n    if(btn){btn.setAttribute('disabled','');}\n    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})\n      .then(function(r){if(!r.ok)throw new Error('add failed');return r.json();})\n      .then(function(){window.location.href='/cart';})\n      .catch(function(){if(btn){btn.removeAttribute('disabled');}window.location.href='/cart';});\n  }\n  document.addEventListener('click',function(e){\n    var btn=e.target.closest&&e.target.closest('.product-form__submit');\n    if(!btn||current!==3)return;\n    e.preventDefault();e.stopPropagation();bundleAdd();\n  },true);\n  var host=document.getElementById('MainProduct-'+SID)||document.body;\n  var t=null;\n  var mo=new MutationObserver(function(){clearTimeout(t);t=setTimeout(apply,150);});\n  mo.observe(host,{childList:true,subtree:true});\n  document.addEventListener('change',function(e){\n    if(e.target&&e.target.closest&&e.target.closest('.product-form__input, variant-radios, variant-selects'))setTimeout(apply,300);});\n  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',apply);}else{apply();}\n})();\n</script>"
          }
