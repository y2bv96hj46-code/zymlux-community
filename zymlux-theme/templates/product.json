    "final_cta": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"position:relative;min-height:72vh;display:grid;place-items:center;text-align:center;overflow:hidden\">\n  <img src=\"https://cdn.shopify.com/s/files/1/1012/8821/4857/files/blackgold-inuse.png?v=1782855518&amp;width=1400\" alt=\"Woman relaxing on the Serenity acupressure mat\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\" loading=\"lazy\">\n  <div style=\"position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,23,20,.55),rgba(18,23,20,.78))\"></div>\n  <div style=\"position:relative;max-width:640px;padding:72px 26px;color:#F4EFE7\">\n    <p style=\"font:500 .72rem/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#C2A06A;margin:0 0 18px\">Tonight</p>\n    <p style=\"font-family:'Fraunces',Georgia,serif;font-weight:300;font-size:clamp(28px,5.4vw,52px);line-height:1.1;margin:0\">Give your evenings somewhere to land.</p>\n    <p style=\"font-family:'Inter',sans-serif;font-size:15px;color:rgba(244,239,231,.88);margin:20px auto 0;max-width:44ch\">The Serenity Acupressure Mat &amp; Neck Pillow Set &mdash; $49.99, with sixty nights to decide.</p>\n    <a href=\"#MainContent\" style=\"display:inline-flex;align-items:center;gap:10px;margin-top:32px;background:#F4EFE7;color:#1F2723;text-decoration:none;font:500 13px/1 'Inter',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:18px 36px\">Shop the set</a>\n  </div>\n</div>",
