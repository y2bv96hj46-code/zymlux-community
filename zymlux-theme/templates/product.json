    "reviews": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- assign jm = product.metafields.judgeme.review_widget_data.value -%}\n<style>\n#zxrv-sec{background:#F4EFE7;padding:clamp(3.5rem,7vw,6rem) 0;font-family:'Inter',sans-serif}\n#zxrv-sec .hd{text-align:center;margin-bottom:34px;padding:0 20px}\n#zxrv-sec .eb{font:500 11.5px/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#7D6130;margin:0 0 16px}\n#zxrv-sec h2{font-family:'Fraunces',Georgia,serif;font-weight:300;letter-spacing:-.02em;color:#36423C;font-size:clamp(28px,4.5vw,44px);margin:0}\n#zxrv-sec .sum{margin:14px 0 0;font-size:14.5px;color:#4A554F}\n#zxrv-sec .sum .st{color:#B58F4F;letter-spacing:3px;font-size:17px;margin-right:8px}\n.zxrv-wrap{position:relative;max-width:1200px;margin:0 auto}\n.zxrv{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px clamp(20px,4vw,40px) 14px;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n.zxrv::-webkit-scrollbar{display:none}\n.zxrv-card{flex:0 0 262px;scroll-snap-align:start;background:#FBF9F4;border:1px solid rgba(43,52,46,.12);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}\n.zxrv-card img{width:100%;height:250px;object-fit:cover;display:block;background:#EBE3D5}\n.zxrv-b{padding:15px 17px 17px;display:flex;flex-direction:column;gap:8px;flex:1}\n.zxrv-stars{color:#B58F4F;letter-spacing:3px;font-size:14px}\n.zxrv-t{margin:0;font-size:13.5px;line-height:1.55;color:#4A554F;flex:1}\n.zxrv-n{margin:0;font:600 12.5px/1 'Inter',sans-serif;color:#36423C}\n.zxrv-n span{display:block;margin-top:5px;font:400 10.5px/1 'Inter',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#8a938d}\n.zxrv-ar{position:absolute;top:42%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;border:1px solid rgba(43,52,46,.2);background:rgba(251,249,244,.95);color:#36423C;font-size:17px;cursor:pointer;display:none;align-items:center;justify-content:center;transition:background .25s;z-index:2}\n.zxrv-ar:hover{background:#1F2723;color:#F4EFE7}\n.zxrv-l{left:6px}.zxrv-r{right:6px}\n@media(min-width:900px){.zxrv-ar{display:flex}}\n#zxrv-sec .jm-full{max-width:1100px;margin:38px auto 0;padding:0 20px}\n</style>\n<div id=\"zxrv-sec\">\n  <div class=\"hd\">\n    <p class=\"eb\">From real customers</p>\n    <h2>In their own words</h2>\n    {%- if jm.number_of_reviews > 0 -%}\n    <p class=\"sum\"><span class=\"st\">&#9733;&#9733;&#9733;&#9733;&#9733;</span>{{ jm.average_rating }}/5 &middot; {{ jm.number_of_reviews }} customer reviews</p>\n    {%- endif -%}\n  </div>\n  {%- if jm.photo_gallery and jm.photo_gallery.size > 0 -%}\n  <div class=\"zxrv-wrap\">\n    <div class=\"zxrv\" id=\"zxrv\">\n      {%- for r in jm.photo_gallery -%}\n      {%- assign pic = r.pictures_urls | first -%}\n      <article class=\"zxrv-card\">\n        {%- if pic -%}<img src=\"{{ pic.compact }}\" alt=\"Customer photo by {{ r.reviewer_name | escape }}\" loading=\"lazy\">{%- endif -%}\n        <div class=\"zxrv-b\">\n          {%- assign rt = r.rating | plus: 0 -%}\n          <div class=\"zxrv-stars\" aria-label=\"{{ r.rating }} out of 5 stars\">{% for i in (1..5) %}{% if i <= rt %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</div>\n          <p class=\"zxrv-t\">{{ r.body_html | strip_html | truncate: 160 }}</p>\n          <p class=\"zxrv-n\">{{ r.reviewer_name }}<span>Verified review</span></p>\n        </div>\n      </article>\n      {%- endfor -%}\n    </div>\n    <button type=\"button\" class=\"zxrv-ar zxrv-l\" aria-label=\"Previous reviews\">&#8592;</button>\n    <button type=\"button\" class=\"zxrv-ar zxrv-r\" aria-label=\"Next reviews\">&#8594;</button>\n  </div>\n  <script>\n  (function(){\n    var tr=document.getElementById('zxrv');if(!tr)return;\n    var l=document.querySelector('.zxrv-l'),r=document.querySelector('.zxrv-r');\n    l&&l.addEventListener('click',function(){tr.scrollBy({left:-580,behavior:'smooth'});});\n    r&&r.addEventListener('click',function(){tr.scrollBy({left:580,behavior:'smooth'});});\n  })();\n  </script>\n  {%- endif -%}\n  <div class=\"jm-full\">\n    <div style=\"clear:both\"></div>\n    <div id=\"judgeme_product_reviews\" class=\"jdgm-widget jdgm-review-widget\" data-id=\"{{ product.id }}\">{{ product.metafields.judgeme.widget }}</div>\n  </div>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "sensation": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n#zxtl{background:#FBF9F4;padding:clamp(3.5rem,7vw,6rem) clamp(1.4rem,4vw,4rem);font-family:'Inter',sans-serif}\n#zxtl .in{max-width:1000px;margin:0 auto;text-align:center}\n#zxtl .eb{font:500 11.5px/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#7D6130;margin:0 0 14px}\n#zxtl h2{font-family:'Fraunces',Georgia,serif;font-weight:300;letter-spacing:-.02em;color:#36423C;font-size:clamp(26px,4vw,40px);margin:0}\n#zxtl .sub{margin:14px auto 0;max-width:52ch;font-size:14.5px;color:#5A645E}\n#zxtl .row{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:clamp(2.2rem,5vw,3.4rem);position:relative}\n#zxtl .row::before{content:\"\";position:absolute;top:9px;left:16.66%;right:16.66%;height:1px;background:linear-gradient(90deg,#C2A06A,#C0683F)}\n#zxtl .st{padding:0 14px;position:relative}\n#zxtl .dot{width:19px;height:19px;border-radius:50%;background:#FBF9F4;border:1.5px solid #C0683F;margin:0 auto;position:relative;z-index:1;display:grid;place-items:center}\n#zxtl .dot::after{content:\"\";width:7px;height:7px;border-radius:50%;background:#C0683F}\n#zxtl .mn{margin:16px 0 0;font-family:'Fraunces',Georgia,serif;font-weight:300;font-size:clamp(24px,3.4vw,34px);color:#36423C;line-height:1}\n#zxtl .mn span{font-size:.45em;font-style:italic;color:#9E4F2E;margin-left:2px}\n#zxtl .tx{margin:10px auto 0;max-width:30ch;font-size:13.5px;line-height:1.65;color:#4A554F}\n@media(max-width:680px){#zxtl .row{grid-template-columns:1fr;gap:26px}#zxtl .row::before{display:none}}\n</style>\n<div id=\"zxtl\"><div class=\"in\">\n<p class=\"eb\">What it feels like</p>\n<h2>The first twenty minutes.</h2>\n<p class=\"sub\">Honest answer: the start is intense. Here is exactly how it goes, so nothing surprises you.</p>\n<div class=\"row\">\n<div class=\"st\"><div class=\"dot\"></div><p class=\"mn\">1<span>min</span></p><p class=\"tx\">A bright, prickly warmth. Intense &mdash; and completely normal. Stay still, breathe slowly.</p></div>\n<div class=\"st\"><div class=\"dot\"></div><p class=\"mn\">3<span>min</span></p><p class=\"tx\">The sharpness melts into a spreading heat as your muscles start to let go.</p></div>\n<div class=\"st\"><div class=\"dot\"></div><p class=\"mn\">20<span>min</span></p><p class=\"tx\">A heavy, quiet calm. Most people don&rsquo;t want to get up &mdash; some are already asleep.</p></div>\n</div>\n</div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "zx_value": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n#zxmath{background:#1F2723;padding:clamp(3.5rem,7vw,6rem) clamp(1.4rem,4vw,4rem);font-family:'Inter',sans-serif;text-align:center}\n#zxmath .eb{font:500 11.5px/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#C2A06A;margin:0 0 14px}\n#zxmath h2{font-family:'Fraunces',Georgia,serif;font-weight:300;letter-spacing:-.02em;color:#F4EFE7;font-size:clamp(26px,4vw,40px);margin:0}\n#zxmath .row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:940px;margin:clamp(2.2rem,5vw,3.4rem) auto 0}\n#zxmath .c{padding:26px 14px;border:1px solid rgba(244,239,231,.14);border-radius:14px}\n#zxmath .c.hl{background:#F4EFE7;border-color:#F4EFE7}\n#zxmath .n{font-family:'Fraunces',Georgia,serif;font-weight:300;font-size:clamp(30px,4.6vw,46px);color:#F4EFE7;line-height:1}\n#zxmath .c.hl .n{color:#1F2723}\n#zxmath .t{margin:12px auto 0;max-width:24ch;font-size:13px;line-height:1.6;color:rgba(244,239,231,.75)}\n#zxmath .c.hl .t{color:#4A554F}\n#zxmath .c.hl .tag{display:inline-block;margin:0 0 12px;background:#1F2723;color:#E3CBA0;font:700 10px/1 'Inter',sans-serif;letter-spacing:.14em;text-transform:uppercase;padding:6px 12px;border-radius:999px}\n#zxmath .ft{margin:26px 0 0;font-family:'Fraunces',Georgia,serif;font-style:italic;font-weight:300;font-size:16px;color:#C2A06A}\n@media(max-width:680px){#zxmath .row{grid-template-columns:1fr}}\n</style>\n<div id=\"zxmath\">\n<p class=\"eb\">Do the math</p>\n<h2>What does unwinding cost you?</h2>\n<div class=\"row\">\n<div class=\"c\"><p class=\"n\">$100</p><p class=\"t\">One deep-tissue massage. Sixty minutes, one appointment, gone by Friday.</p></div>\n<div class=\"c\"><p class=\"n\">$400<span style=\"font-size:.4em\">+</span></p><p class=\"t\">A month of weekly massages &mdash; if you can find the time to book them.</p></div>\n<div class=\"c hl\"><span class=\"tag\">The Serenity Set</span><p class=\"n\">$49.99</p><p class=\"t\">Once. Twenty minutes a night, every night, in your own bedroom &mdash; for years.</p></div>\n</div>\n<p class=\"ft\">Sixty nights to decide &mdash; love it, or your money back.</p>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "zx_madefor": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n#zxwho{background:#F4EFE7;padding:clamp(3.5rem,7vw,6rem) clamp(1.4rem,4vw,4rem);font-family:'Inter',sans-serif}\n#zxwho .in{max-width:1060px;margin:0 auto}\n#zxwho .hd{text-align:center;margin-bottom:clamp(2rem,5vw,3rem)}\n#zxwho .eb{font:500 11.5px/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#7D6130;margin:0 0 14px}\n#zxwho h2{font-family:'Fraunces',Georgia,serif;font-weight:300;letter-spacing:-.02em;color:#36423C;font-size:clamp(26px,4vw,40px);margin:0}\n#zxwho .sub{margin:14px auto 0;max-width:46ch;font-size:14.5px;color:#5A645E;text-align:center}\n#zxwho .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n#zxwho .card{background:#FBF9F4;border:1px solid rgba(43,52,46,.12);border-radius:14px;padding:28px 26px}\n#zxwho .num{font-family:'Fraunces',Georgia,serif;font-style:italic;font-weight:300;font-size:15px;color:#9E4F2E;margin:0 0 10px}\n#zxwho h3{font-family:'Fraunces',Georgia,serif;font-weight:400;font-size:20px;color:#36423C;margin:0 0 10px}\n#zxwho p.tx{margin:0;font-size:13.5px;line-height:1.7;color:#4A554F}\n@media(max-width:680px){#zxwho .grid{grid-template-columns:1fr}}\n</style>\n<div id=\"zxwho\"><div class=\"in\">\n<div class=\"hd\">\n<p class=\"eb\">Who it&rsquo;s for</p>\n<h2>Made for the ones who carry too much.</h2>\n<p class=\"sub\">Body or mind &mdash; this is where you put it down.</p>\n</div>\n<div class=\"grid\">\n<div class=\"card\"><p class=\"num\">01</p><h3>The desk marathon</h3><p class=\"tx\">Eight hours over a keyboard, shoulders creeping toward your ears. Twenty minutes on the mat undoes what the chair did &mdash; lying down, doing nothing.</p></div>\n<div class=\"card\"><p class=\"num\">02</p><h3>The mind that won&rsquo;t clock out</h3><p class=\"tx\">The to-do list follows you to bed. The prickle-then-warmth of 6,000 points gives your attention one simple thing to feel &mdash; and the spiral quietly runs out of fuel.</p></div>\n<div class=\"card\"><p class=\"num\">03</p><h3>On your feet all day</h3><p class=\"tx\">Teachers, nurses, moms &mdash; the ones everyone else leans on. This is the evening version of finally putting the weight down.</p></div>\n<div class=\"card\"><p class=\"num\">04</p><h3>The 9pm collapse</h3><p class=\"tx\">No energy left for a 90-minute routine? Good &mdash; this isn&rsquo;t one. Lie down, breathe, get up lighter. That&rsquo;s the whole ritual.</p></div>\n</div>\n</div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "zx_lifestyle": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n#zxlife{background:#FBF9F4;padding:clamp(3.5rem,7vw,6rem) clamp(1.2rem,4vw,3rem);font-family:'Inter',sans-serif}\n#zxlife .hd{text-align:center;margin-bottom:clamp(2rem,4vw,3rem)}\n#zxlife .eb{font:500 11px/1 'Inter',sans-serif;text-transform:uppercase;letter-spacing:.3em;color:#7D6130;margin:0 0 14px}\n#zxlife h2{font-family:'Fraunces',Georgia,serif;font-weight:300;letter-spacing:-.02em;color:#36423C;font-size:clamp(25px,4vw,38px);margin:0}\n#zxlife h2 em{font-style:italic;color:#C0683F}\n#zxlife .sub{margin:14px auto 0;max-width:44ch;font-size:14px;color:#5A645E}\n#zxlife .g{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(.8rem,1.6vw,1.3rem)}\n#zxlife figure{position:relative;margin:0;overflow:hidden;border-radius:3px}\n#zxlife .pw{position:relative;aspect-ratio:3/4;overflow:hidden;background:#EBE3D5}\n#zxlife img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}\n#zxlife figure:hover img{transform:scale(1.06)}\n#zxlife figcaption{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:26px 20px 18px;color:#F4EFE7;background:linear-gradient(transparent,rgba(14,16,13,.72));font-family:'Fraunces',Georgia,serif;font-weight:300;font-size:1.25rem;line-height:1.2}\n#zxlife figcaption span{display:block;font:500 .6rem/1 'Inter',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#E3CBA0;margin-bottom:8px}\n@media(max-width:760px){#zxlife .g{grid-template-columns:1fr;max-width:420px}}\n</style>\n<section id=\"zxlife\">\n<div class=\"hd\"><p class=\"eb\">The Quiet Hour, at home</p><h2>A ritual that looks like <em>yours</em></h2><p class=\"sub\">On the bed, on the floor, by candlelight &mdash; wherever the day finally lets go.</p></div>\n<div class=\"g\">\n<figure><div class=\"pw\"><img src=\"https://cdn.shopify.com/s/files/1/1012/8821/4857/files/home-g-bed.jpg?v=1783627297\" alt=\"The Serenity acupressure set laid out on a bed\" loading=\"lazy\" width=\"900\" height=\"1200\"></div><figcaption><span>Bedside</span>Before the light goes out</figcaption></figure>\n<figure><div class=\"pw\"><img src=\"https://cdn.shopify.com/s/files/1/1012/8821/4857/files/home-g-floor.jpg?v=1783627296\" alt=\"The Serenity set on a cozy living room floor by candlelight\" loading=\"lazy\" width=\"900\" height=\"1200\"></div><figcaption><span>Living room</span>Twenty minutes to yourself</figcaption></figure>\n<figure><div class=\"pw\"><img src=\"https://cdn.shopify.com/s/files/1/1012/8821/4857/files/home-g-rug.jpg?v=1783627296\" alt=\"The Serenity mat unrolled on a warm patterned rug\" loading=\"lazy\" width=\"900\" height=\"1200\"></div><figcaption><span>Anywhere calm</span>Right where you rest</figcaption></figure>\n</div>\n</section>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
