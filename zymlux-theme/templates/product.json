zx-jmbadge .jdgm-prev-badge{display:block!important}\n\n.product-form__input input[type=radio]+label{display:inline-flex;align-items:center;gap:8px}\n.product-form__input input[type=radio]+label::before{content:\"\";width:14px;height:14px;border-radius:50%;flex:none;border:1px solid rgba(43,52,46,.3);background:#ccc}\n.product-form__input input[value=\"Black Gold\"]+label::before{background:radial-gradient(circle at 35% 35%,#C2A06A 0 45%,#17130C 48%)}\n.product-form__input input[value=\"Black & White\"]+label::before{background:radial-gradient(circle at 35% 35%,#F2F0EB 0 45%,#1B1B1D 48%)}\n.product-form__input input[value=\"Green\"]+label::before{background:radial-gradient(circle at 35% 35%,#8CA189 0 45%,#55684F 48%)}\n.product-form__input input[type=radio]:checked+label::before{border-color:#F4EFE7}\n/* Zymlux — product gallery polish (no ratio hacks; images are uniform 3:4) */\n.product__media,.product__media img,.product__media-item .global-media-settings{border-radius:10px}\n.thumbnail-list__item .thumbnail{border-radius:7px;border:1px solid rgba(43,52,46,.16);transition:border-color .2s,box-shadow .2s}\n.thumbnail-list__item .thumbnail img{object-fit:cover;border-radius:7px}\n.thumbnail.is-active,.thumbnail[aria-current=\"true\"]{border-color:#1F2723!important;box-shadow:0 0 0 1px #1F2723}\n@media(min-width:750px){.product__media-wrapper{max-width:440px;margin-inline:auto}}\n\n/* remove neighbour-image peek in the mobile media slider */\n.product__media-list{scroll-padding:0!important;padding-left:0!important;padding-right:0!important;gap:0!important;column-gap:0!important}\n.product__media-list .product__media-item{scroll-snap-align:start!important}\n@media(max-width:989px){.product__media-list .product__media-item,.product__media-list .slider__slide{flex:0 0 100%!important;width:100%!important;max-width:100%!important;margin-right:0!important;margin-left:0!important}}\n</style>"
