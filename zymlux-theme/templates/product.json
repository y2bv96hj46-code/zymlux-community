            "custom_liquid": "<style>\n.zxchips{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 10px}\n.zxchips span{display:inline-flex;align-items:center;gap:6px;font:600 11.5px/1 'Inter',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#4A554F;background:#FFFFFF;border:1px solid rgba(43,52,46,.16);border-radius:999px;padding:8px 12px}\n.zxchips svg{width:13px;height:13px;flex:none;fill:none;stroke:#7D6130;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n</style>\n<div class=\"zxchips\" aria-label=\"Guarantees\">\n<span><svg viewBox=\"0 0 24 24\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg>60-night trial</span>\n<span><svg viewBox=\"0 0 24 24\"><path d=\"M1 8h13v8H1z\"/><path d=\"M14 11h4l3 3v2h-7\"/><circle cx=\"6\" cy=\"18\" r=\"1.6\"/><circle cx=\"17\" cy=\"18\" r=\"1.6\"/></svg>Free U.S. shipping</span>\n<span><svg viewBox=\"0 0 24 24\"><path d=\"M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z\"/><path d=\"M9 12l2 2 4-4\"/></svg>Secure checkout</span>\n</div>"
